#include <windows.h>

// Qt's Windows platform plugin looks this name up for the windows' own icon as well.
IDI_ICON1 ICON "@TV_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @TV_VERSION_RC@
PRODUCTVERSION @TV_VERSION_RC@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TokenViewer"
            VALUE "FileDescription", "TokenViewer"
            VALUE "FileVersion", "@TV_APP_VERSION@"
            VALUE "InternalName", "TokenViewer"
            VALUE "LegalCopyright", "Copyright (c) 2026 jy.seong. MIT License."
            VALUE "OriginalFilename", "TokenViewer.exe"
            VALUE "ProductName", "TokenViewer"
            VALUE "ProductVersion", "@TV_APP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
